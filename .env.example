# mainnet or testnet (both must match)
ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# Neon pooled connection string (Dashboard > Connect > Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Blocks per eth_getLogs request when rechecking an invoice
ARC_LOGS_CHUNK=10000

# Public base URL used in share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
